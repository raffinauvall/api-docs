# Server configuration — salin jadi .env dan sesuaikan
NODE_ENV=development
PORT=4000

# Client origin (untuk CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL lokal) ---
DATABASE_URL=postgres://nox14@localhost:5432/api_docs
PGDATA=../pgdata

# --- Session (WAJIB — string acak minimal 32 karakter) ---
SESSION_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter
# Set true hanya di production HTTPS
COOKIE_SECURE=false

# --- Portal SSO SMG (pola SMG-EMPmvp) ---
PORTAL_HOST=https://portal.smg.co.id
PORTAL_CORP=SMG

# --- GitHub (untuk sinkronisasi OpenAPI dari repository) ---
# Personal access token (opsional, untuk repo private)
GITHUB_TOKEN=
# Webhook secret (untuk verifikasi signature)
GITHUB_WEBHOOK_SECRET=

# --- Dev mode ---
# true = aktifkan POST /api/auth/dev-login (hanya saat NODE_ENV !== production)
DEV_AUTH=true
